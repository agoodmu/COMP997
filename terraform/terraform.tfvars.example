# Copy to terraform.tfvars and edit. terraform.tfvars identifies your
# deployment, so keep it out of version control.

# 5-12 lowercase letters/digits; choose a NEW suffix per study so nothing
# collides with an earlier deployment.
suffix = "jianmin3"

region             = "us-east-1"
log_retention_days = 90

# true  = main run (injected documents carry the self-announcing label)
# false = robustness check (label stripped); flip and re-apply, then run S1.
carrier_label = true

# Path to the fixtures generated by generate_data.py (Terraform seeds from it).
fixtures_path = "../data/fixtures.json"

# Agent package built by package_agent.py.
agent_zip_path = "../build/agent.zip"
